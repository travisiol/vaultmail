# Public site URL (canonical links, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3990

# Where payments settle. 4663 = Robinhood Chain (default). 31337 = local Hardhat node (npm run e2e uses it).
NEXT_PUBLIC_VAULT_CHAIN_ID=4663
# NEXT_PUBLIC_VAULT_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_VAULT_EXPLORER_URL=https://robinhoodchain.blockscout.com

# The server's own chain and RPC for verifying payment receipts, read at runtime
# (defaults: the public values above). The e2e scripts set these to a local Hardhat node.
# VAULT_CHAIN_ID=4663
# VAULT_RPC_URL=

# Where the SQLite file lives. Default ./data/vaultmail.db; falls back to the OS temp dir on a read-only host (ephemeral!).
# VAULTMAIL_DB_PATH=
