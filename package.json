{
  "name": "vaultmail",
  "version": "0.1.0",
  "private": true,
  "description": "VAULT MAIL \u2014 your wallet has an inbox. Wallet-to-wallet messages, invoices and payment requests, sealed end-to-end, paid onchain.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --port 3990",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "capture": "node scripts/capture.mjs",
    "e2e:ui": "node scripts/ui-e2e.mjs",
    "mark:build": "tsx scripts/build-mark.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-query": "^5.102.7",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "viem": "^2.56.0",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
